# MCP transport: "stdio" for local dev; "streamable-http" for Docker/remote
MCP_TRANSPORT=streamable-http

# MCP network settings (used with streamable-http transport)
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# FastMCP only: FastMCP reads these specific env vars for host/port binding.
# FASTMCP_HOST=0.0.0.0
# FASTMCP_PORT=8000

# Logging (byteforge-loki-logging). Only used with streamable-http; stdio never
# configures it (stdout carries the JSON-RPC stream).
# DEBUG_LOCAL: 'true' = console logs, 'false' = ship to Loki (compose sets false)
DEBUG_LOCAL=true
LOG_LEVEL=INFO

# Loki (required when DEBUG_LOCAL=false)
LOKI_ENDPOINT=https://loki.example.com/loki/api/v1/push
LOKI_USER=your_loki_user
LOKI_PASSWORD=your_loki_password
# Host path of the Loki CA cert; compose mounts it at /app/certs/loki-ca.pem
LOKI_CA_BUNDLE_HOST_PATH=/path/to/loki-ca.pem
